# Frontend (valores públicos — a chave anon é protegida pelo RLS)
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<chave anon (legacy JWT) do projeto>

# Segredos das Edge Functions: configure no painel do Supabase
# (Project Settings > Edge Functions > Secrets). NUNCA coloque no frontend.
# META_APP_ID=            META_APP_SECRET=
# TIKTOK_CLIENT_KEY=      TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=       GOOGLE_CLIENT_SECRET=
# PINTEREST_APP_ID=       PINTEREST_APP_SECRET=
# ML_CLIENT_ID=           ML_CLIENT_SECRET=
# GEMINI_API_KEY=         (opcional, IA)   ANTHROPIC_API_KEY= (opcional)
# APP_URL=                (opcional; também pode ficar no Vault como app_url)
